OPENROUTER_API_KEY=your_openrouter_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Server-only. Onixus creates the Stripe Checkout and customer-portal links.
ONIXUS_API_URL=https://your-onixus-api.example


# Coding team: server-only gateway settings. Provider IDs, not API keys.
VELTRA_CODING_TEAM_ENABLED=true
VELTRA_PLANNER_MODEL=deepseek/deepseek-chat
VELTRA_CODER_MODEL=qwen/qwen-2.5-coder-32b-instruct
VELTRA_REVIEWER_MODEL=deepseek/deepseek-chat
VELTRA_VISION_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Optional: reuse the authenticated Veltra gateway for flexible CRM phrasing.
AI_GATEWAY_URL=
CRM_CHAT_MODEL=
# Server-only: verified Signal business linking (never use a client-prefixed service key).
# SUPABASE_SERVICE_ROLE_KEY=
# SIGNAL_SUPABASE_PUBLISHABLE_KEY=
